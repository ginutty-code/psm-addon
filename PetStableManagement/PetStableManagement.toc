## Interface: 120007, 121000
## Title: Pet Stable Management
## Notes: Complementary pet stable panel for collection management (with advanced sorting, filtering, persistent pet data storage), and pet model browser panel for discovering next taming choices
## Author: Ginutty
## Version: 12.4.1
## IconTexture: 132253
## SavedVariables: PetStableManagementDB PSM_UserNotes
# Do NOT list PetStableManagement_Data / _ModelsBrowser here. OptionalDeps means
# "load these before me if enabled", which both defeats their ## LoadOnDemand and
# inverts the load order so they run before this addon creates _G.PSM.
# They depend on us, not the other way round -- see their ## RequiredDeps.
## OptionalDeps: Blizzard_StableUI

# Core modules (loaded first)
Core.lua

# Strings, shared with the Models Browser via PSM.L. Early, because anything that
# builds a label at file scope needs L to already exist.
Shared/Locale.lua

# State -- one home per piece of shared mutable state, with the accessor that owns it.
# Early, because it depends on nothing but SavedVariables.
State/Store.lua
State/Filters.lua
State/Selections.lua

# Shared modules
Shared/Config.lua
Shared/Utils.lua

# UI kit -- generic widget factories, loaded before anything that builds frames.
# Nothing in here knows what a pet is; see UI/Widgets.lua.
UI/Theme.lua
UI/Skin.lua
UI/Tooltip.lua
UI/Widgets.lua

Shared/Loader.lua
Shared/Events.lua
Shared/UI.lua
Shared/Dialogs.lua
Shared/Minimap.lua
Shared/SlashCommands.lua
Shared/OptionsPanel.lua
Shared/PanelManager.lua
Shared/RowManager.lua
Shared/Data.lua
Shared/Menu.lua
Shared/Broker.lua
Shared/PopUpManager.lua

# Owned Pets feature
OwnedPets/PetTooltip.lua
OwnedPets/Panel.lua
OwnedPets/GridView.lua
OwnedPets/GroupedView.lua
OwnedPets/Row.lua
OwnedPets/Filters.lua
OwnedPets/Reorder.lua
OwnedPets/Export.lua
OwnedPets/DragDrop.lua
OwnedPets/PetGroups.lua
OwnedPets/TeamsData.lua
OwnedPets/TeamsPanel.lua

# Loaded last, and it must stay last: it publishes core's public members onto _G.PSM
# for the Models Browser, which cannot happen until every file above has attached
# itself. See Shared/PublicAPI.lua.
Shared/PublicAPI.lua
